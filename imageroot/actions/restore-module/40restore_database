set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

# Load the dump into a fresh Percona data volume with the restored
# credentials (percona.env is part of the backup), then stop.
mkdir -vp initdb.d
mv -v minthcm.sql initdb.d
cat - >initdb.d/zz_minthcm_restore.sh <<'EOS'
# The script is sourced by the image entrypoint: stop the temporary server
set -- true
docker_temp_server_stop
exit 0
EOS
trap 'rm -rfv initdb.d/' EXIT

podman run \
  --rm \
  --interactive \
  --network=none \
  --volume=./initdb.d:/docker-entrypoint-initdb.d:z \
  --volume mysql-data:/var/lib/mysql/:Z \
  --env-file=percona.env \
  --replace --name=restore_db \
  ${PERCONA_IMAGE}
