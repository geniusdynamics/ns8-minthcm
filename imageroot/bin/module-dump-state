#

set -e

if ! systemctl --user -q is-active minthcm.service; then
    exit 0
fi

# Dump the MintHCM database from the Percona container
podman exec percona-app sh -c 'exec mysqldump -u root -p"${MYSQL_ROOT_PASSWORD}" \
    --databases minthcm \
    --default-character-set=utf8mb4 \
    --skip-dump-date \
    --single-transaction \
    --quick \
    --add-drop-table' > minthcm.sql
